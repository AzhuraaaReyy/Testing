# ---------------------------------------------------------------------------------------------
# Panduan production (SEC-08, SEC-10). Nilai di bawah file ini untuk pengembangan lokal.
#   APP_ENV=production
#   APP_DEBUG=false                 # wajib: debug menampilkan stack trace & detail konfigurasi
#   APP_URL=https://domain-sekolah  # wajib domain asli: Host lain ditolak (400)
#   LOG_LEVEL=warning
#   SESSION_SECURE_COOKIE=true      # cookie hanya lewat HTTPS (bawaan production: true)
#   SESSION_ENCRYPT=true            # isi session terenkripsi (bawaan production: true)
# Langkah lain:
#   - composer install --no-dev --optimize-autoloader (tanpa paket pengembangan seperti Boost)
#   - php artisan sekolah:buat-admin (jangan db:seed: seeder ditolak di production)
#   - cron scheduler: * * * * * cd /path/aplikasi && php artisan schedule:run >> /dev/null 2>&1
#   - Di balik reverse proxy/load balancer HTTPS: atur trustProxies agar HTTPS & IP terbaca benar.
#   - CORS API: hanya APP_URL; frontend lain yang sah via CORS_ALLOWED_ORIGINS (dipisah koma).
#   - Pantau log keamanan: storage/logs/security-YYYY-MM-DD.log (disimpan LOG_SECURITY_DAYS=90 hari).
# ---------------------------------------------------------------------------------------------

APP_NAME="Sistem Manajemen Sekolah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database aplikasi: MySQL (PRD 3.4). Test memakai SQLite di memori (phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=testing_sekolah
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# SESSION_ENCRYPT tidak diisi: bawaan true di production, false di lokal (config/session.php).
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
